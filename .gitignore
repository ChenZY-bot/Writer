# ============================================================
# 隐私：绝不入库
# ============================================================
# 含 API Key / 火山引擎 endpoint id
/config/agent_config.yml
# 含本机绝对路径与作品输出目录
/config/settings_config.yml
# 作品大纲 / 临时导演笔记
/config/outline.txt
/config/director_notes.txt
# 人工干预指令流水（含剧情决策）
/config/directives/inbox.jsonl
/config/directives/applied.jsonl

# ============================================================
# 运行时数据：正文、记忆、日志（只忽略仓库根目录下的）
# 注意：不能写成 `memory/`，那样会把 agent/memory/ 源码也忽略掉
# ============================================================
/output/
/memory/
/logs/
*.log

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# 测试临时目录（沙箱下可能残留不可删的子目录）
tests/.tmp/
.tmp*
.tmp_*

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

